#Refreshes the list of available packages from the repositories
sudo apt update

#Upgrades all installed packages to their latest available versions
sudo apt upgrade

#Installs the "parted" utility on Debian-based systems
sudo apt install parted

#Displays partition details, then disk structure, separating outputs with lines
sudo parted -l && echo -e "\n--\n" && lsblk -f && echo -e "\n--\n"

#Lists the partition tables of all detected storage devices
parted -l

#Shows disks and partitions along with their file system information
lsblk -f

#Runs the next command only if the previous one was successful
&&

#Prints a line break with separators for better readability
"\n--\n"

#Checks if the system is using UEFI; otherwise prints BIOS
[ -d /sys/firmware/efi ] && echo "UEFI" || echo "BIOS"

#Creates a file named test.txt and writes "mi archivo" into it
echo "mi archivo " > test.txt

